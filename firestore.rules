rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone can browse the catalog; only an admin account can add or
    // remove products. Any signed-in customer (including guest/anonymous
    // checkout) can update ONLY the stock field, so checkout can
    // decrement stock without being able to touch price, name, etc.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
      );
    }

    // Combo/meal sets (a drink + a pastry sold together at a discount).
    // Same shape as products: public read, admin-only write — nothing
    // here needs the customer-writable "stock" carve-out products.js
    // has, since a combo's own stock is derived live from its linked
    // drink/pastry products, never stored on the combo doc itself.
    match /combos/{comboId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Product categories (built by the admin's "Add Category" form —
    // see categories-service.js). Same public-read/admin-write shape
    // as products/combos: everyone needs to read these to build the
    // Menu/Merchandise sidebars, only an admin can define new ones.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // NOTE: settings-service.js reads/writes settings/general (the
    // delivery fee) but this collection had no rule at all, which
    // means Firestore's default-deny was silently blocking
    // updateDeliveryFee() for every admin. Same public-read/admin-write
    // shape as everything else configuration-like above.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Any signed-in customer can create their own order; the order's
    // owner, an admin, or (for delivery orders) a rider can read it back.
    // Rider read access: an unclaimed delivery order that's ready for
    // pickup (so riders can see what's available to claim), or any
    // order already assigned to that rider (riderId == their own uid),
    // regardless of status (so completed deliveries still show in
    // their own history).
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider' &&
          (
            resource.data.riderId == request.auth.uid ||
            (resource.data.fulfillment == 'delivery' && resource.data.status == 'ready' && resource.data.riderId == null)
          )
        )
      );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // A rider claiming an unassigned, ready delivery order — may
        // only set riderId to their own uid, nothing else.
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider' &&
          resource.data.riderId == null &&
          resource.data.fulfillment == 'delivery' &&
          resource.data.status == 'ready' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['riderId']) &&
          request.resource.data.riderId == request.auth.uid
        ) ||
        // A rider updating status/proof on an order already assigned
        // to them — may only touch status and deliveryProof, and may
        // only move it to out_for_delivery, completed, or back to
        // ready (e.g. if they have to hand it off), never touch riderId
        // itself once assigned (admin reassignment is a separate case
        // below) or any customer/pricing field.
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rider' &&
          resource.data.riderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryProof']) &&
          request.resource.data.status in ['ready', 'out_for_delivery', 'completed']
        )
      );
      allow delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/edit only their own profile doc — PLUS, for the
    // admin dashboard's Accounts tab: an admin can read any profile,
    // list the whole collection, and update another account's role or
    // disabled flag specifically (never any other field on someone
    // else's profile, and never their OWN role/disabled — that's what
    // stops an admin from silently self-blocking or self-demoting by
    // accident, or a compromised admin session escalating itself
    // further). Registration always writes role:'customer' (see
    // auth.js), so create requires that too — nobody can self-register
    // as admin.
    match /users/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow list: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == 'customer';
      allow update: if request.auth != null && (
        // Owner editing their own profile — unchanged from before: any
        // field except role, unless they're already an admin.
        (request.auth.uid == userId && (
          !('role' in request.resource.data.diff(resource.data).affectedKeys()) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )) ||
        // An admin managing a DIFFERENT account's role/disabled flag —
        // this is the new part the Accounts tab needs.
        (request.auth.uid != userId &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'disabled']))
      );
    }

    // A customer's saved delivery addresses, stored as a subcollection
    // under their own user doc (users/{uid}/addresses/{addressId}).
    // NOTE: this was missing entirely — Firestore security rules don't
    // cascade from a parent match block to its subcollections, so
    // /users/{userId} above never covered this, and every read/write
    // from addresses-service.js was silently hitting the default-deny.
    // Same owner-only shape as carts/wishlists below.
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // A customer's cart doc id is their own uid — only they can read
    // or write it. This is what lets web and mobile share one cart.
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    // Same pattern as carts: one doc per user, doc id = their own uid,
    // holding the full list of saved product ids.
    match /wishlists/{wishlistId} {
      allow read, write: if request.auth != null && request.auth.uid == wishlistId;
    }

    // Reviews are public to read (they're social proof on the product
    // page) but writes are locked down three ways: (1) the doc id must
    // be `${productId}_${uid}`, a deterministic composite key rather than
    // an auto-id — that's what makes "one review per person per product"
    // automatic, since a second submission just overwrites the first
    // instead of creating a duplicate; (2) the uid field in the review
    // must match the writer's own uid, so nobody can post a review that
    // impersonates someone else; (3) anonymous/guest sessions (used for
    // guest checkout) can't post at all, since a review should be tied to
    // a real account. Only the review's own author (or an admin, for
    // moderation) can delete it.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        reviewId == (request.resource.data.productId + '_' + request.auth.uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow delete: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
